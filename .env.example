# Copy to .env and adjust as needed. All variables are prefixed with LIMON_.
LIMON_DEBUG=false
LIMON_DATABASE_URL=sqlite+aiosqlite:///./limon.db
# JSON list of allowed CORS origins; use ["*"] for local development.
LIMON_CORS_ORIGINS=["*"]
# Supabase project URL — bearer tokens are verified against its JWKS endpoint.
LIMON_SUPABASE_URL=https://your-project-ref.supabase.co
# Backend-only key used for Supabase Auth administration.
LIMON_SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Only needed for legacy Supabase projects still signing tokens with HS256.
# LIMON_SUPABASE_JWT_SECRET=

# Google Cloud Storage — target bucket for audio upload presign URLs.
# Unset => the uploads endpoint returns 503. Uses Application Default
# Credentials (run: gcloud auth application-default login).
# LIMON_GCS_BUCKET=limon-dev-<you>
# Service account whose identity signs the upload URLs (via IAM signBlob).
# LIMON_GCS_SIGNER_SERVICE_ACCOUNT=limon-signer@<project>.iam.gserviceaccount.com
# How long a presigned upload URL stays valid (seconds; default 900 = 15 min).
# LIMON_GCS_SIGNED_URL_TTL_SECONDS=900

# GroqCloud — automatic tag suggestion from entry text.
# Create an API key at https://console.groq.com/keys
LIMON_TAGGER_API_KEY=YOUR_GROQ_API_KEY
LIMON_TAGGER_MODEL=qwen/qwen3.8-27b
LIMON_TAGGER_BASE_URL=https://api.groq.com/openai/v1

# Hebrew transcriber — the Oracle VPS box, over its async job API.
# Submit -> callback -> drain -> persist -> ack. Design and the full contract:
# spec/research/2026-09-transcriber-job-api.md
#
# The base URL is a Cloudflare Quick Tunnel and rotates on every tunnel restart.
# Do not treat a stale one as an incident; re-read it with
#   ssh oracle-vps 'cd ~/hebrew-transcriber && ./deploy/cpu/tunnel-url.sh --check'
LIMON_TRANSCRIBER_BASE_URL=https://your-tunnel.trycloudflare.com
# Bearer token on every box route but /health. Secret Manager in production.
LIMON_TRANSCRIBER_TOKEN=YOUR_TRANSCRIBER_AUTH_TOKEN
# Shared secret the box presents on the callback (X-Callback-Token). We choose
# it; it is set on the box as CALLBACK_SECRET. Unset => the callback endpoint
# rejects every call rather than going open.
LIMON_TRANSCRIBER_CALLBACK_SECRET=YOUR_CALLBACK_SECRET
# Pre-flight limits, mirroring the box's own, so a submission that would be
# refused with 413 is never sent.
LIMON_TRANSCRIBER_MAX_AUDIO_DURATION_S=600
LIMON_TRANSCRIBER_MAX_UPLOAD_BYTES=26214400
